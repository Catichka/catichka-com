---
import Base from '../layouts/Base.astro';
import { hero, about, expertise, experience, research, contact, art } from '../site';
---
<Base>
  <section class="hero wrap">
    <p class="kicker">{hero.kicker}</p>
    <h1>{hero.name}</h1>
    <p class="hero-line">{hero.line}</p>
    <div class="actions">
      {hero.actions.map((a) => <a class:list={['btn', { ghost: a.ghost }]} href={a.href}>{a.label}</a>)}
    </div>
    <img class="hero-art" src={art.hero} alt={art.heroAlt} width="1076" height="629" fetchpriority="high" />
  </section>

  <section id="about" class="section wrap about">
    <h2>About</h2>
    <div class:list={['about-body', { 'has-portrait': art.portrait }]}>
      {art.portrait && <img class="portrait" src={art.portrait} alt="Catherine Campbell" />}
      <div>{about.paragraphs.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <section id="expertise" class="section wrap">
    <h2>Expertise</h2>
    <ul class="cards">
      {expertise.map((e) => (<li class="card"><h3>{e.title}</h3><p>{e.body}</p></li>))}
    </ul>
  </section>

  <section id="experience" class="section wrap">
    <h2>Experience</h2>
    <ol class="timeline">
      {experience.map((x) => (
        <li>
          <p class="role">{x.role}</p>
          <h3>{x.href ? <a href={x.href}>{x.org} <span aria-hidden="true">↗</span></a> : x.org}</h3>
          <p class="muted">{x.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="research" class="section wrap">
    <h2>Research and speaking</h2>
    <p class="lede">{research.intro}</p>
    <ul class="cards two">
      {research.items.map((r) => (<li class="card"><h3>{r.title}</h3><p>{r.body}</p></li>))}
    </ul>
    <ul class="pills">
      {research.links.map((l) => (<li><a href={l.href}>{l.label} ↗</a></li>))}
    </ul>
  </section>

  <section id="contact" class="section wrap contact">
    <h2>Contact</h2>
    <p class="lede">{contact.line}</p>
    <p><a class="email" href={`mailto:${contact.email}`}>{contact.email}</a></p>
    <ul class="pills">
      {contact.links.map((s) => (<li><a href={s.href}>{s.label} ↗</a></li>))}
    </ul>
  </section>
</Base>
