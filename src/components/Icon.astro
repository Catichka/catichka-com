---
// Hand-drawn style line icons. Placeholders until ChatGPT's section icons (batch 2, item 5) arrive.
interface Props { name: string }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 48 48" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === 'spark' && <><path d="M24 6c1.5 8 4 10.5 12 12-8 1.5-10.5 4-12 12-1.5-8-4-10.5-12-12 8-1.5 10.5-4 12-12z" /><path d="M37 31c.6 3 1.5 4 4.5 4.5-3 .6-3.9 1.5-4.5 4.5-.6-3-1.5-3.9-4.5-4.5 3-.5 3.9-1.5 4.5-4.5z" /></>}
  {name === 'bridge' && <><path d="M5 34h38" /><path d="M8 34c4-12 28-12 32 0" /><path d="M16 34v-8M24 34v-10M32 34v-8" /><path d="M6 40c6-2 30-2 36 0" /></>}
  {name === 'network' && <><circle cx="24" cy="12" r="4" /><circle cx="11" cy="34" r="4" /><circle cx="37" cy="34" r="4" /><circle cx="24" cy="27" r="2.5" /><path d="M24 16v8.5M22 28.5l-8 3.5M26 28.5l8 3.5M14.5 32l6-17M33.5 32l-6-17" /></>}
</svg>
